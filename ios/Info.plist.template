<?xml version="1.0" encoding="UTF-8"?>
<!--
  When `npx cap add ios` runs on a Mac, it generates ios/App/App/Info.plist.
  Merge the keys below into that file. They cover the App-Store-required
  metadata that Capacitor's default skeleton omits.
-->
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>Shift AI</string>

  <key>CFBundleShortVersionString</key>
  <string>1.0.0</string>

  <key>CFBundleVersion</key>
  <string>1</string>

  <key>LSRequiresIPhoneOS</key>
  <true/>

  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>

  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <key>UIRequiresFullScreen</key>
  <true/>

  <key>UIStatusBarStyle</key>
  <string>UIStatusBarStyleDefault</string>

  <key>UIViewControllerBasedStatusBarAppearance</key>
  <true/>

  <key>UILaunchStoryboardName</key>
  <string>LaunchScreen</string>

  <!-- Privacy strings (required even if features are unused) -->
  <key>NSPhotoLibraryUsageDescription</key>
  <string>Shift AI uses your photo library to set a profile picture so your resume can include it.</string>

  <key>NSCameraUsageDescription</key>
  <string>Shift AI uses the camera to capture a profile picture.</string>

  <!-- App Transport Security: lock to HTTPS only (default) -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <false/>
    <key>NSAllowsLocalNetworking</key>
    <false/>
  </dict>

  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>

  <key>UIApplicationSupportsIndirectInputEvents</key>
  <true/>
</dict>
</plist>
