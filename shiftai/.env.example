# ────────────────────────────────────────────────────────
# LLM PROVIDERS — GROQ_API_KEY is the only REQUIRED key.
# Everything else is optional; the app runs 100% free.
# ────────────────────────────────────────────────────────

# Groq — free at https://console.groq.com/keys
# REQUIRED. Powers extraction, synthesis, scoring (Llama 3.3 70B).
GROQ_API_KEY=

# Gemini 2.5 Flash — free at https://aistudio.google.com/apikey
# Optional. Native Google-grounded search for venue research.
# Without it, a keyless DuckDuckGo search path is used instead.
GEMINI_API_KEY=

# OpenRouter — free at https://openrouter.ai/keys
# Optional fallback chat/extract provider.
OPENROUTER_API_KEY=

# OpenAI — optional PAID last-resort fallback. Never hit while free paths work.
OPENAI_API_KEY=

# ────────────────────────────────────────────────────────
# ADMIN + ANALYTICS (all optional)
# ────────────────────────────────────────────────────────

# Gates /admin and /api/admin/events.
ADMIN_TOKEN=

# Optional Upstash KV — persists last 5000 events for /admin.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
